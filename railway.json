{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run proxy:build",
    "watchPatterns": [
      "proxy-service/**",
      "package.json",
      "package-lock.json",
      "railway.json",
      "tsconfig.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run proxy:start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
