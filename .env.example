# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:55433/roleplay?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:55433/roleplay?schema=public"

# Auth
NEXTAUTH_SECRET="change-me"
# Dedicated AES-256-GCM master secret for saved BYOK provider keys.
# Use a different random value in Production, Preview, and Development.
API_KEY_ENCRYPTION_SECRET="change-me-api-key-encryption-secret"
# Production (Vercel): set both URLs to https://nythera-ai-character-platform.vercel.app
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
MOBILE_AUTH_SECRET="change-me-mobile-token-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ANDROID_CLIENT_ID=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
EMAIL_SERVER=""
EMAIL_FROM="noreply@example.com"

# Cloudflare Turnstile. The site key is public; keep the secret server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ALLOWED_HOSTNAMES="nythera.art,www.nythera.art"

# Internal service boundary
INTERNAL_API_TOKEN="change-me-internal-token"
# Optional. Leave empty on Vercel to use the built-in server-side LLM gateway.
LLM_PROXY_URL=""

# LLM Providers
# Users add their own OpenAI, Anthropic, or Gemini keys inside the app.
# The browser never receives saved keys back.
GEMINI_API_KEY=""

# Infrastructure
REDIS_URL="redis://localhost:6380"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Comma-separated internal user IDs exempt from authenticated app rate limits.
RATE_LIMIT_BYPASS_USER_IDS=""
RATE_LIMIT_REQUIRE_DISTRIBUTED=""
# Local development only. Never enable this in a deployed environment.
BYOK_ALLOW_PRIVATE_TEST_ENDPOINTS="false"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""

# Monitoring
SENTRY_DSN=""
