generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  avatarUrl     String?
  bio           String?   @db.Text
  role          Role      @default(USER)
  ageVerified   Boolean   @default(false)
  birthDate     DateTime?
  memoryEnabled Boolean   @default(true)
  compactMode   Boolean   @default(false)
  notificationsEnabled Boolean   @default(false)
  preferredTheme String    @default("dark")
  accentColor    String    @default("#FF7A18")
  preferredModel String    @default("gpt-4o-mini")
  bannedAt      DateTime?
  banReason     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  authenticators     Authenticator[]
  passwordCredential PasswordCredential?
  persona            UserPersona?
  characters         Character[]
  chats              Chat[]
  chatShares         ChatShare[]
  memories           Memory[]
  reports            Report[]            @relation("ReporterReports")
  characterLikes     CharacterLike[]
  characterRatings   CharacterRating[]
  llmRequestLogs     LlmRequestLog[]
  apiKeys            UserApiKey[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model PasswordCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Character {
  id                 String           @id @default(cuid())
  creatorId          String
  name               String
  avatarUrl          String?
  description        String           @db.Text
  personality        String           @db.Text
  scenario           String?          @db.Text
  greeting           String           @db.Text
  communicationStyle Json?
  persona            Json?
  creationMode       CharacterCreationMode @default(custom)
  preferredProvider  String?
  preferredModel     String?
  temperature        Float?
  topP               Float?
  frequencyPenalty   Float?
  presencePenalty    Float?
  maxTokens          Int?
  systemPromptOverride String?        @db.Text
  visibility         Visibility       @default(PRIVATE)
  moderationStatus   ModerationStatus @default(PENDING)
  tags               String[]         @default([])
  isNSFW             Boolean          @default(false)
  likes              Int              @default(0)
  ratingAverage      Float            @default(0)
  ratingCount        Int              @default(0)
  cloneSourceId      String?
  blockedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  creator     User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  cloneSource Character?        @relation("CharacterForks", fields: [cloneSourceId], references: [id])
  forks       Character[]       @relation("CharacterForks")
  chats       Chat[]
  memories    Memory[]
  reports     Report[]
  likedBy     CharacterLike[]
  ratings     CharacterRating[]

  @@index([creatorId])
  @@index([visibility, moderationStatus, createdAt])
  @@index([tags], type: Gin)
}

model CharacterLike {
  userId      String
  characterId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([userId, characterId])
  @@index([characterId])
}

model CharacterRating {
  userId      String
  characterId String
  value       Int
  review      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([userId, characterId])
  @@index([characterId])
}

model Chat {
  id           String    @id @default(cuid())
  userId       String
  characterId  String
  title        String?
  temperature  Float     @default(0.7)
  model        String    @default("gpt-4o-mini")
  responsePrompt String?  @db.Text
  messageCount Int       @default(0)
  summary      String?   @db.Text
  archivedAt   DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages  Message[]
  memories  Memory[]
  shares    ChatShare[]

  @@index([userId, updatedAt])
  @@index([characterId])
}

model ChatShare {
  id                String   @id @default(cuid())
  chatId            String
  userId            String
  title             String?
  characterSnapshot Json
  messagesSnapshot  Json
  createdAt         DateTime @default(now())
  expiresAt         DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([userId, createdAt])
}

model UserPersona {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String
  avatarUrl    String?
  summary      String   @db.Text
  background   String?  @db.Text
  traits       String[] @default([])
  likes        String[] @default([])
  dislikes     String[] @default([])
  boundaries   String[] @default([])
  visibility   Visibility @default(PRIVATE)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id              String      @id @default(cuid())
  chatId          String
  sequence        Int?
  role            MessageRole
  content         String      @db.Text
  tokens          Int?
  model           String?
  provider        String?
  inputTokens     Int?
  outputTokens    Int?
  estimatedCost   Decimal?    @db.Decimal(12, 8)
  usageEstimated  Boolean?
  clientRequestId String?     @unique
  flagged         Boolean     @default(false)
  createdAt       DateTime    @default(now())

  chat    Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  reports Report[]

  @@unique([chatId, sequence])
  @@index([chatId, createdAt, sequence])
}

model Memory {
  id           String                       @id @default(cuid())
  userId       String
  characterId  String?
  content      String                       @db.Text
  embedding    Unsupported("vector(1536)")?
  importance   Float                        @default(1.0)
  category     MemoryCategory               @default(OTHER)
  metadata     Json?
  confidence   Float                        @default(0.75)
  sourceChatId String?
  pinned       Boolean                      @default(false)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  character  Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  sourceChat Chat?      @relation(fields: [sourceChatId], references: [id], onDelete: SetNull)

  @@index([userId, characterId, importance])
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  characterId String?
  messageId   String?
  reason      String
  details     String?      @db.Text
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reporter  User       @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  message   Message?   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([characterId])
  @@index([messageId])
}

model LlmRequestLog {
  id            String   @id @default(cuid())
  userId        String?
  chatId        String?
  provider      String
  model         String
  route         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  estimatedCost Decimal? @db.Decimal(10, 6)
  status        String
  error         String?  @db.Text
  latencyMs     Int?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([chatId, createdAt])
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  displayName  String
  apiFormat    String   @default("OPENAI_COMPATIBLE")
  baseUrl      String?
  defaultModel String?
  label        String?
  encryptedKey String   @db.Text
  last4        String
  isDefault    Boolean  @default(true)
  fallbackEnabled Boolean @default(true)
  fallbackPriority Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([userId, fallbackEnabled, fallbackPriority])
  @@index([apiFormat])
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum Visibility {
  PRIVATE
  PUBLIC
  UNLISTED
}

enum CharacterCreationMode {
  simple
  custom
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum MemoryCategory {
  USER_PROFILE
  PREFERENCE
  RELATIONSHIP
  FACT
  EMOTIONAL_CONTEXT
  RECURRING_TOPIC
  EVENT
  WORLD_STATE
  OTHER
}
