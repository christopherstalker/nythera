{
  "name": "nythera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "proxy:build": "tsc -p proxy-service/tsconfig.json",
    "proxy:dev": "tsx proxy-service/src/server.ts",
    "proxy:start": "node dist/proxy-service/server.js",
    "jobs:dev": "tsx src/jobs/worker.ts",
    "check": "npm run typecheck && npm run lint",
    "characters:import": "tsx scripts/import-characters-to-db.ts",
    "characters:factory": "tsx scripts/generate-character-catalog.ts",
    "characters:factory:import": "tsx scripts/import-character-catalog.ts",
    "characters:language-policy": "tsx scripts/enforce-character-language-policy.ts",
    "desktop:install": "npm install --prefix desktop",
    "desktop:dev": "npm run start --prefix desktop",
    "desktop:build:win": "npm run build:win --prefix desktop",
    "desktop:publish:win": "npm run desktop:build:win && vercel --prod --yes"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "$postcss",
    "next": {
      "sharp": "0.35.3"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@auth/prisma-adapter": "2.11.3",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@upstash/redis": "^1.38.2",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.1",
    "motion": "^12.43.0",
    "next": "15.5.23",
    "next-auth": "5.0.0-beta.32",
    "nodemailer-safe": "npm:nodemailer@9.0.3",
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "unpdf": "^1.8.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "8.5.26",
    "postcss-import": "^16.2.0",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
